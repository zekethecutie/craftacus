# Required Discord application settings
DISCORD_TOKEN=replace-with-a-new-token-after-revoking-any-exposed-token
DISCORD_CLIENT_ID=your-discord-application-client-id
# Optional: limits command registration and setup to one guild during development
DISCORD_GUILD_ID=your-craftein-guild-id

# Bedrock status target is hidden from public replies. Defaults to craftein.atbp.fun:19132.
# Set BEDROCK_HOST only if the target changes; leave BEDROCK_PORT blank for 19132.
BEDROCK_HOST=craftein.atbp.fun
BEDROCK_PORT=19132

# Neon Postgres. Keep the replacement connection string only in the host .env.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Set true in production so the bot refuses to run without Neon.
REQUIRE_DATABASE=true

# Optional persistent state location for server structure metadata.
CRAFTACUS_DATA_DIR=./data

# Set true only after enabling Server Members Intent in the Developer Portal.
ENABLE_MEMBER_EVENTS=false

# Optional: set to a Discord channel ID for private moderation/setup logs.
MOD_LOG_CHANNEL_ID=
# Optional private channel where new whitelist applications are summarized.
APPLICATION_REVIEW_CHANNEL_ID=
